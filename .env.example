# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Vercel production: replace with the public HTTPS URL of the deployed FastAPI backend.
# VITE_API_BASE_URL=https://your-backend.example.com
# Optional: set to an ID returned by GET /models.
# VITE_MODEL_ID=efficientnetv2-s

# Backend deployment: comma-separated frontend origins.
# FRONTEND_ORIGINS=https://your-frontend.example.com